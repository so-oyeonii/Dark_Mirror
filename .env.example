# All local demos work without these values. Adding keys does NOT enable auth or DB reads.
# Public project URL and anon/publishable key only. Never put a secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Reserved for live integration; unused by the current local demos. Server only.
# Never prefix with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
